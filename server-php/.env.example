# ---------------------------------------------------------------------------
# Voice API — server environment template
#
# Copy to .env ON THE SERVER:  cp .env.example .env
# .env is never committed and is excluded from the deploy rsync, so a
# --delete deploy cannot remove it.
#
# Unlike the React build, this file is read at RUNTIME on every request.
# Changing a value here takes effect on the next request; no rebuild.
# ---------------------------------------------------------------------------

APP_ENV=production
APP_PRODUCT_KEY=voice

# Which deployment this is: production, sandbox or local. It decides which
# Manage (the tenant check), Contacts, CRM, Calendar, Pay and AI Pulse this API
# talks to, and it is read from HERE ONLY — never from a request's Host header,
# which is a claim. When unset, APP_ENV above is used; when neither is a
# recognised value, Voice calls no other product at all (fail closed) and
# /api/health says so. Service keys are also bound to it (see SERVICE_KEYS).
AIC_ENVIRONMENT=production

# --- Database --------------------------------------------------------------
# Voice's OWN PostgreSQL database and nothing else. It is never pointed at
# another product's database: Books, Manage, Contacts and the rest are reached
# through their HTTP APIs. A cross-database connection here would not be a
# shortcut, it would be the architecture failing.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
# DB_SCHEMA=

# --- Phone numbers ---------------------------------------------------------
# The region a number typed WITHOUT a country code is read in, when the
# company has not chosen one in Settings (and before the fallback, IN). A
# number starting + or 00 is never re-interpreted. Contacts reads national
# numbers in the same order (request, company, CONTACTS_DEFAULT_PHONE_REGION,
# IN), so a number typed here and one stored there land on the same E.164.
# VOICE_DEFAULT_PHONE_REGION=IN

# --- Local development -----------------------------------------------------
# Only needed when `npm run dev` on localhost talks to a deployed API. In both
# deployed environments the app and this API share an origin and no CORS
# headers are sent at all.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Portal ----------------------------------------------------------------
# The auth API is my.aicountly.com in every environment. Override only for
# local testing against a stub.
# PORTAL_AUTH_BASE=https://my.aicountly.com

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# 32 bytes, base64. Generate with:  head -c 32 /dev/urandom | base64
#
# Telephony credentials are encrypted with this before they reach the database.
# WITHOUT IT, STORING A PROVIDER CREDENTIAL IS REFUSED — this product does not
# silently fall back to plaintext, because encryption that downgrades when its
# key is missing is decorative.
#
# Rotating it makes existing stored credentials undecryptable; re-enter them.
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Voice Gateway — telephony and media
# ---------------------------------------------------------------------------
# The separate service that owns SIP, WebRTC, RTP, streaming speech
# recognition and synthesis, barge-in and playback. PHP cannot do any of that
# inside a web request, which is why it is its own service.
#
# With these unset there is NO browser calling, NO live transcription and no
# gateway provider connection. The UI says so on every screen that needs them
# rather than showing controls that do nothing.
VOICE_GATEWAY_URL=
VOICE_GATEWAY_KEY=

VOICE_GATEWAY_ENABLED=0
VOICE_BROWSER_CALLING_ENABLED=0
VOICE_TRANSCRIPTION_ENABLED=0

# Languages the configured speech services actually serve, comma separated.
# An AI agent claiming a language that is not in this list is flagged in
# validation rather than published — a caller answered in a language the agent
# cannot hear is worse than one told it is not supported.
# VOICE_SUPPORTED_LANGUAGES=en,hi

# ---------------------------------------------------------------------------
# Recording storage
# ---------------------------------------------------------------------------
# Private object storage. Playback URLs are signed per request and expire in
# five minutes; they are never stored and never logged.
RECORDING_STORAGE_URL=
RECORDING_SIGNING_KEY=
# Local filesystem root, when the retention sweeper deletes objects itself
# rather than relying on the gateway's lifecycle rules.
# RECORDING_STORAGE_PATH=

# ---------------------------------------------------------------------------
# Rate card
# ---------------------------------------------------------------------------
# Integer MINOR units per minute (paise for INR). With these unset, calls are
# not priced and the usage screens say so — a zero would read as a free call
# rather than as an unpriced one.
# RATE_OUTBOUND_MINOR_PER_MINUTE=120
# RATE_INBOUND_MINOR_PER_MINUTE=60
# RATE_CARD_VERSION=2026-01

# ---------------------------------------------------------------------------
# AI — runs through AI Pulse
# ---------------------------------------------------------------------------
# Voice's AI (call summaries today) is sent to the AI Pulse gateway with the
# signed-in user's own session. Pulse picks the model from Console, enforces the
# daily AI allowance and reports usage per feature. NO MODEL KEY, MODEL NAME OR
# PROVIDER GOES IN THIS FILE — Voice never calls a model provider itself.
#
# The switch. Off: summaries are rule-based and the screens say AI is off.
VOICE_AI_ENABLED=0
#
# Pulse's origin. Leave it unset: AIC_ENVIRONMENT=sandbox (and local) use the
# sandbox, https://pulse.gh.aicountly.com, and production uses
# https://pulse.aicountly.com. Set it only to point somewhere else.
# PULSE_API_ORIGIN=https://pulse.aicountly.com
#
# Only for AI started with no user session — another product's backend calling
# Voice with X-Service-Key. Falls back to CONSOLE_SERVICE_KEY, the same estate
# service key. With neither, such a request gets the rule-based summary.
# PULSE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Other Aicountly products
# ---------------------------------------------------------------------------
# Every one of these is reached through its LIVE API. Voice stores references,
# never copies of their records. A product left unconfigured is shown as not
# connected, with the variable to set — never as a working integration.
#
# The *_API_BASE overrides are for local development and cutovers; in a
# deployed environment the sibling's host follows AIC_ENVIRONMENT (production
# siblings for production, the *.gh.aicountly.com sandbox otherwise).

VOICE_CALENDAR_ENABLED=0
CALENDAR_SERVICE_KEY=
# CALENDAR_API_BASE=

VOICE_CRM_ENABLED=0
CRM_SERVICE_KEY=
# CRM_API_BASE=

VOICE_PAY_ENABLED=0
PAY_SERVICE_KEY=
# PAY_API_BASE=

VOICE_LOBBY_ENABLED=0
LOBBY_SERVICE_KEY=
# LOBBY_API_BASE=

VOICE_MESSAGING_ENABLED=0
MESSAGING_SERVICE_KEY=
# MESSAGING_API_BASE=

# Contacts is read through its COMPANY endpoints with the signed-in user's own
# session, so Manage's verdict and their Contacts role apply. On by default.
# VOICE_CONTACTS_ENABLED=1
# CONTACTS_API_BASE=
#
# Voice's product key for Contacts (contract v1 §3.9). Campaign workers have no
# session: when a person starts, resumes or configures a campaign, Voice asks
# Contacts for a company-scoped READ grant with that person's session plus this
# key, stores the grant encrypted (CREDENTIAL_ENCRYPTION_KEY) and the worker
# uses it. Contacts holds only the key's sha256 in CONTACTS_SERVICE_CREDENTIALS
# ("voice:<sha256>"). Without it a campaign with a Contacts audience is refused
# at launch, saying so. Grant lifetime in seconds, 600..86400 (default 28800);
# an expired or refused grant pauses the campaign until a person resumes it.
CONTACTS_SERVICE_KEY=
# VOICE_CONTACTS_GRANT_TTL=28800

# Manage owns companies and branches, and the tenant check reads it on every
# scoped request.
# MANAGE_API_BASE=

# ---------------------------------------------------------------------------
# Inbound service keys
# ---------------------------------------------------------------------------
# What OTHER products present when they call Voice. Format:
#   SERVICE_KEYS=lobby:<key>,crm:<key>,appointments:<key>
# A key proves which product is calling, and that decides the origin recorded
# against any call it creates — a request body cannot claim one.
SERVICE_KEYS=

# ---------------------------------------------------------------------------
# Voice-owned capabilities
# ---------------------------------------------------------------------------
# On unless a business does not want them.
# VOICE_CAMPAIGNS_ENABLED=1
# VOICE_INTELLIGENCE_ENABLED=1
# VOICE_REALTIME_ENABLED=1
