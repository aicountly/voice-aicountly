# ---------------------------------------------------------------------------
# Apache config for the built SPA on cPanel.
# Vite copies everything in public/ into dist/, so this ships with the build.
# ---------------------------------------------------------------------------

# HTTPS only: a plain-http request is redirected (301) to the same URL on https.
# It never loops behind a TLS-terminating proxy: a request that arrived over TLS, that the proxy
# marks as https (X-Forwarded-Proto / X-Forwarded-SSL) or that came in on port 443 is left alone.
# localhost and 127.0.0.1 stay on http for local development.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP:X-Forwarded-SSL} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{HTTP_HOST} .
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- SPA history fallback --------------------------------------------------
# Client-side routes have no file on disk. Send anything that is not a real
# file or directory to index.html so a refresh or deep link does not 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never swallow Let's Encrypt validation requests.
  RewriteRule ^\.well-known/ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed asset filenames change on every build, so cache them hard.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached, or a deploy is invisible to clients.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Hardening -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Clickjacking: no AICOUNTLY screen is meant to be framed by another site
  # (security audit 2026-10). frame-ancestors is the CSP form, X-Frame-Options
  # the legacy one. This CSP restricts framing, <base> and plugins only — it does
  # not restrict scripts, styles or connections, so it cannot break the app.
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  # Browsers keep to HTTPS for a year once they have seen the site over HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Deny access to any dotfile that somehow lands in the docroot (e.g. .env),
# except .well-known which must stay reachable for SSL renewal.
RedirectMatch 404 /\.(?!well-known)
